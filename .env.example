# AI provider credentials. Leave blank unless you use the interactive root CLI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Provider defaults.
DEFAULT_AI_PROVIDER=openai
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-opus-20240229

# Redis configuration for the root rule engine.
REDIS_URL=redis://localhost:6379
REDIS_RULE_TTL=604800

# Analysis settings.
MIN_SESSION_LENGTH=3
GAP_THRESHOLD=0.3
MIN_GAPS_FOR_RULE=2
VALIDATION_SAMPLE_SIZE=100
EFFECTIVENESS_THRESHOLD=0.15
LOG_LEVEL=INFO
# Blue-green deployment (optional)
BG_BLUE_SPACE_ID=vooom/AI_Rule_Learning
BG_GREEN_SPACE_ID=vooom/AI_Rule_Learning_Green
BG_LIVE_COLOR=blue
BG_HEALTH_PATH=/
# BG_ROUTER_CUTOVER_URL=https://router.example.com/cutover
# BG_ROUTER_TOKEN=replace-with-router-token
